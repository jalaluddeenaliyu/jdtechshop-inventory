# Copy this file to `.env` (same folder) and fill in real values.
# NEVER commit `.env` to Git — it is already listed in .gitignore.

# development | production | test
ENVIRONMENT=development

# PostgreSQL connection.
# On a Mac with Homebrew Postgres, your macOS username usually works with no password:
#   DATABASE_URL=postgresql+psycopg://localhost:5432/jdtechshop
DATABASE_URL=postgresql+psycopg://localhost:5432/jdtechshop

# Used only by the automated tests. Tests WIPE this database, so never point it at real data.
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/jdtechshop_test

# Long random string used to sign login sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# How long a login lasts, in minutes (720 = 12 hours, roughly one shop day).
ACCESS_TOKEN_MINUTES=720

# Set to true when the app is served over HTTPS (production). Keep false for http://localhost.
COOKIE_SECURE=false

# Business time zone. "Today" in reports means a calendar day in this zone.
BUSINESS_TIMEZONE=Africa/Lagos
